// Copie este arquivo para "secrets.h" (mesma pasta). "secrets.h" está no
// .gitignore de propósito — nunca commite seu conteúdo.
//
//   cp include/secrets.h.example include/secrets.h
//
// NÃO tem WIFI_SSID/WIFI_PASS aqui: o firmware não conecta numa rede fixa
// hardcoded. A rede é configurada pelo portal de WiFi (segure o botão BOOT
// da placa por 5s, ou — com a caixa fechada — Push button 1 + Push
// button 2 juntos por 5s) e fica salva no NVS do próprio ESP32, sobrevive
// a reboot/power cycle. Ver docs/ARCHITECTURE.md seção "Como o WiFi
// conecta".
#pragma once

#define OTA_HOSTNAME  "esp32s3-buttonbox" // nome mDNS usado pelo env [env:ota]
